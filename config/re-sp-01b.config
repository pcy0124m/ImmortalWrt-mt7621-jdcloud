# ================= 目标平台：京东云 RE-SP-01B (MT7621) =================
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

# 设备默认包（kmod-mt7603 / kmod-mt7615-firmware / kmod-mmc-mtk /
# kmod-usb3 / automount 等）选对设备后自动带上，不用重复填。

# ================= 常用增强插件（按需增减） =================
# --- 去广告 DNS ---
CONFIG_PACKAGE_adguardhome=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y

# --- 内网穿透 ---
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# --- 动态域名 ---
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# --- 常用工具 ---
CONFIG_PACKAGE_luci-app-ttyd=y          # 网页终端
CONFIG_PACKAGE_luci-app-wol=y           # 网络唤醒
CONFIG_PACKAGE_luci-app-upnp=y          # UPnP 自动端口映射
CONFIG_PACKAGE_luci-theme-argon=y       # Argon 主题
CONFIG_PACKAGE_openssh-sftp-server=y    # SFTP 传文件

# --- USB 存储（U盘/移动硬盘） ---
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y

# ===== Argon 主题 =====
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# 关键：防止 Argon 依赖拉入 wget-nossl，导致刷机后 apk update 失效
# （这是 25.12 的已知坑，见 openwrt/openwrt#24270）
CONFIG_PACKAGE_wget-ssl=y

