# Target 平台：京东云 RE‑SP‑01B
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
# MULTI_PROFILE=y + CONFIG_TARGET_DEVICE_...（带 DEVICE_ 前缀）为正确组合，只编译 RE-SP-01B 单设备
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y

# 内核模块基础
CONFIG_ALL_KMODS=n
CONFIG_DEVEL=n

# 文件系统 squashfs
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_JFFS2=n

# 基础系统工具
CONFIG_BUSYBOX_CUSTOM=y

# --------------------------
# 【重点禁用大包，解决固件超限】
# --------------------------
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_luci-app-docker=n

CONFIG_PACKAGE_luci-app-diskman=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_autosamba=n
CONFIG_PACKAGE_samba4-server=n

# 不装大量nas相关组件
CONFIG_PACKAGE_luci-app-nas=n
CONFIG_PACKAGE_luci-app-filemanager=n

# --------------------------
# 保留常用Luci组件
# --------------------------
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Argon主题
CONFIG_PACKAGE_luci-theme-argon=y

# 网络基础
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-system=y

# 诊断工具
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y

# USB支持（接U盘后期装插件用，不占固件多大空间）
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_usbutils=y

# 关闭不需要语言，瘦身
CONFIG_LUCI_LANG_other=n
CONFIG_LUCI_LANG_en=n
CONFIG_LUCI_LANG_zh-cn=y

# --------------------------
# OpenAppFilter 应用过滤（上网管控）
# 注意：含内核模块 kmod-oaf，必须编译进固件；使用时会与 NAT 硬件加速/流量分载(flow offload)冲突，
# 刷机后如需启用 OAF，请先关闭加速/分载相关开关。
# --------------------------
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y
