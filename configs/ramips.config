# ============================================================
# iStoreOS 配置文件 - 京东云 RE-SP-01B (MT7621)
# ============================================================
# ---------- 目标平台 ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_jdcloud_re-sp-01b=y
# ---------- 固件格式 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=160
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ---------- 内核模块 ----------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-cp936=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-scsi-generic=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

# ---------- 基础工具 ----------
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim-fuller=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_sudo=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_zip=y
CONFIG_PACKAGE_pv=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfatprogs=y
CONFIG_PACKAGE_ntfs3-mount=y

# ---------- iStore 软件中心（必须） ----------
CONFIG_PACKAGE_luci-app-store=y

# ---------- 主题 ----------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ---------- 网络共享 ----------
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_autosamba=y

# ---------- 下载工具 ----------
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_aria2=y

# ---------- 网络工具 ----------
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y
CONFIG_PACKAGE_ddns-scripts_dnspod=y

# ---------- VPN ----------
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ---------- 网络加速 ----------
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_shortcut-fe=y
CONFIG_PACKAGE_kmod-shortcut-fe=y
CONFIG_PACKAGE_kmod-fast-classifier=y

# ---------- 系统监控 ----------
CONFIG_PACKAGE_luci-app-netdata=y

# ---------- 磁盘管理 ----------
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-mountd=y

# ---------- 打印服务（可选，不需要可以注释掉） ----------
# CONFIG_PACKAGE_luci-app-p910nd=y

# ---------- Docker（MT7621 内存小，不建议开启，需要的话取消注释） ----------
# CONFIG_PACKAGE_luci-app-dockerman=y
# CONFIG_PACKAGE_dockerd=y
# CONFIG_PACKAGE_docker-compose=y

# ---------- 科学上网（需要的话取消注释，注意插件来源） ----------
# CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-openclash=y

# ---------- 关闭不需要的默认包（减小固件体积） ----------
CONFIG_PACKAGE_luci-app-firewall=n
